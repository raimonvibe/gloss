# Copy this file to android/key.properties and fill in the two passwords.
#
#   key.properties is gitignored and must stay that way. The upload key is the
#   one thing here that cannot be regenerated: once the app is on Play, every
#   update must carry the same certificate, so losing it means losing the
#   ability to ship an update at all.

storeFile=C:/Users/rober/Documents/Keys-beautiful-words/upload-keystore.jks
storePassword=<the keystore password>
keyAlias=upload
keyPassword=<the same password again>

# --- what is known about this key -------------------------------------------
#
# Dedicated Gloss upload key, created 2026-08-28. PKCS12 store despite the
# .jks name (what modern keytool produces). PKCS12 has no separate per-key
# password, so keyPassword is necessarily the same string as storePassword;
# Gradle just wants both fields.
#
#   package      com.raimonvibe.beautiful_words
#   alias        upload
#   owner        CN=Gloss, OU=Mobile, O=Raimonvibe, L=Amsterdam, ST=NH, C=NL
#   valid        2026-08-28 to 2054-01-13
#   SHA-256      A1:2B:46:D2:19:08:B2:B1:C6:EC:E4:5E:52:2A:C9:E2:
#                6E:35:98:6E:8F:56:A9:5C:DF:AA:85:61:43:91:54:21
#
# This is NOT the Wonders key (Documents/keys2) and NOT the older
# Documents/Keys/upload-keystore.jks. Do not reuse those for this package:
# the first bundle Play accepts for com.raimonvibe.beautiful_words locks
# this certificate permanently.
#
# storeFile is absolute on purpose. Keeping the .jks outside the project
# means a zip of the source tree, a screen share or a stray `git add -f`
# cannot carry it away with everything else. The password lives next to
# the keystore, also outside the repo.
#
# --- verifying --------------------------------------------------------------
#
# Read the keystore (asks for the password):
#   keytool -list -v -keystore C:/Users/rober/Documents/Keys-beautiful-words/upload-keystore.jks
#
# Read what a built bundle was actually signed with (no password):
#   keytool -printcert -jarfile build/app/outputs/bundle/release/app-release.aab
#
# The two SHA-256s must match. If the bundle shows "CN=Android Debug" instead,
# key.properties was missing or malformed and Gradle fell back to debug
# signing — silently, producing a normal-looking bundle that Play rejects.
